  exports({ to: app.makePath('app/audit_resolvers/tenant_resolver.ts') })
}}}
import { HttpContext } from '@adonisjs/core/http'
import { TenantResolver } from 'adonis-auditing'

export default class implements TenantResolver {
  async resolve(ctx: HttpContext): Promise<{ id: number | string } | null> {
    // Adjust this according to your user/tenant model structure
    const auth = (ctx as any).auth
    const user = auth?.user as { tenantId?: number | string } | undefined
    return user?.tenantId ? { id: user.tenantId } : null
  }
}
